<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NvidiaVibrance"
             xmlns:vm="using:NvidiaVibrance.ViewModels"
             x:Class="NvidiaVibrance.App"
             x:DataType="vm:MainWindowViewModel"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/control-vibrance.ico" 
                      ToolTipText="Nvidia Vibrance Control"
                      Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Reset" Command="{Binding ResetVibranceCommand}"/>
                        <NativeMenuItem Header="Monochrome" IsChecked="{Binding IsMonochrome}" Command="{Binding ToggleMonochromeCommand}"/>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>